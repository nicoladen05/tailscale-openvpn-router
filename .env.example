# Tailscale
TS_AUTH_KEY=tskey-auth-...
# TS_HOSTNAME=openvpn-router
# TS_EXTRA_ARGS=--accept-dns=false

# OpenVPN credentials (only needed if the config uses auth-user-pass)
OVPN_USER=
OVPN_PASS=
# Config file to use, defaults to the only *.ovpn file in /config
# OVPN_CONFIG=/config/client.ovpn
# OpenVPN server addresses, auto-detected from the config's "remote" lines if unset
# OVPN_SERVER_IPS=203.0.113.10,203.0.113.11

# Comma-separated IPv4 CIDRs to route through the VPN and advertise on the tailnet
# (optional when EXIT_NODE=true)
VPN_ROUTES=10.0.0.0/8,192.168.1.10/32

# Also act as an exit node that sends all traffic of its clients through the VPN
# EXIT_NODE=true
